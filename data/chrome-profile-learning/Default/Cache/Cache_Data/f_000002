:root {
  --font-sans: "Inter", "Segoe UI", -apple-system, sans-serif;
  --font-mono: "JetBrains Mono", "Fira Code", "Consolas", monospace;

  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;

  --c-bg: #070d1f;
  --c-surface-1: #0a1228;
  --c-surface-2: #0f1a35;
  --c-surface-3: #141f3f;
  --c-border: #1b2845;

  --c-text-1: #eef2ff;
  --c-text-2: #b2c0df;
  --c-text-3: #7d90b8;

  --c-accent: #4c87ff;
  --c-accent-dim: rgba(76, 135, 255, 0.18);
  --c-green: #10c87a;
  --c-red: #ff4060;
  --c-yellow: #ffa830;
  --c-success: #10c87a;
  --c-success-dim: rgba(16, 200, 122, 0.16);
  --c-danger: #ff4060;
  --c-danger-dim: rgba(255, 64, 96, 0.16);
  --c-warning: #ffa830;
  --c-warning-dim: rgba(255, 168, 48, 0.16);
  --c-purple: #a78bfa;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-height: 100%;
}

body {
  font-family: var(--font-sans);
  background:
    radial-gradient(circle at 0 0, rgba(76, 135, 255, 0.2), transparent 28%),
    radial-gradient(circle at 100% 0, rgba(16, 200, 122, 0.16), transparent 28%),
    var(--c-bg);
  color: var(--c-text-1);
}

h1,
h2,
h3,
p {
  margin: 0;
}

.app-shell {
  min-height: 100vh;
  display: flex;
}

.sidebar {
  width: 184px;
  border-right: 1px solid var(--c-border);
  background: rgba(10, 18, 40, 0.94);
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
  padding: var(--space-4) var(--space-3);
  gap: var(--space-4);
  z-index: 20;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding-bottom: var(--space-4);
  border-bottom: 1px solid var(--c-border);
}

.brand-badge {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--c-accent), var(--c-success));
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 700;
}

.brand-title {
  font-size: 13px;
  font-weight: 700;
}

.brand-subtitle {
  font-size: 10px;
  color: var(--c-text-3);
}

.menu {
  display: grid;
  gap: var(--space-1);
}

.menu-item {
  width: 100%;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--c-text-3);
  display: flex;
  align-items: center;
  gap: var(--space-2);
  text-align: left;
  padding: 9px 10px;
  font-size: 12px;
  cursor: pointer;
  transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
}

.menu-item i[data-lucide] {
  width: 15px;
  height: 15px;
  flex-shrink: 0;
  stroke-width: 1.8;
}

.menu-item:hover,
.menu-item.is-active {
  color: var(--c-accent);
  border-color: rgba(76, 135, 255, 0.28);
  background: var(--c-accent-dim);
}

.menu-icon {
  width: 16px;
  text-align: center;
  font-size: 11px;
}

.sidebar-footer {
  margin-top: auto;
  border-top: 1px solid var(--c-border);
  padding-top: var(--space-3);
}

.sidebar-action-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 10px;
  border-radius: 9px;
  font-size: 12px;
  color: var(--c-text-3);
  background: transparent;
  border: 1px solid transparent;
  cursor: pointer;
  width: 100%;
  min-height: 34px;
  justify-content: flex-start;
}

.sidebar-action-btn:hover {
  color: var(--c-text-2);
  background: var(--c-surface-2);
  border-color: var(--c-border);
}

.user-chip {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.user-avatar {
  width: 28px;
  height: 28px;
  border-radius: 9px;
  background: var(--c-accent);
  display: grid;
  place-items: center;
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
}

.user-name {
  font-size: 11px;
  color: var(--c-text-2);
}

.user-plan {
  font-size: 9px;
  color: var(--c-text-3);
}

.content-shell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding-bottom: 74px;
}

.topbar {
  min-height: 48px;
  border-bottom: 1px solid var(--c-border);
  background: rgba(10, 18, 40, 0.88);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: 8px var(--space-5);
  position: sticky;
  top: 0;
  z-index: 10;
}

.ghost-btn {
  display: none;
  border: 1px solid var(--c-border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--c-text-2);
  padding: 6px 10px;
}

.topbar-title {
  font-size: 14px;
  font-weight: 700;
}

.topbar-subtitle {
  font-size: 11px;
  color: var(--c-text-3);
}

.panel-head-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.dashboard-head-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: wrap;
}

.ghost-btn-inline {
  border: 1px solid var(--c-border);
  background: transparent;
  color: var(--c-text-2);
}

.panel-note {
  margin-top: -8px;
  font-size: 11px;
  color: var(--c-text-3);
}

.topbar-status {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.feed-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border-radius: 999px;
  border: 1px solid var(--c-border);
  padding: 6px 10px;
  font-size: 10px;
  font-weight: 600;
}

.feed-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 8px currentColor;
}

.feed-success {
  color: var(--c-success);
  background: var(--c-success-dim);
}

.feed-warning {
  color: var(--c-warning);
  background: var(--c-warning-dim);
}

.feed-danger {
  color: var(--c-danger);
  background: var(--c-danger-dim);
}

.clock {
  color: var(--c-text-2);
  font-size: 12px;
}

.main-content {
  padding: var(--space-5);
  display: grid;
  gap: var(--space-4);
}

.hero-card {
  border: 1px solid var(--c-border);
  border-radius: var(--radius-lg);
  background: linear-gradient(140deg, rgba(76, 135, 255, 0.14), rgba(16, 200, 122, 0.1));
  padding: var(--space-5);
  display: grid;
  gap: var(--space-2);
}

.eyebrow {
  color: var(--c-accent);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 10px;
  font-weight: 700;
}

.hero-card h1 {
  font-size: clamp(24px, 3.3vw, 38px);
  line-height: 1.08;
}

.hero-card p {
  color: var(--c-text-2);
  font-size: 13px;
  max-width: 900px;
}

.view-panel {
  display: none;
  gap: var(--space-4);
  flex-direction: column;
}

.view-panel.is-active {
  display: flex;
}

.panel-head h2 {
  font-size: 18px;
  font-weight: 700;
}

.subpanel {
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  background: rgba(15, 26, 53, 0.88);
  display: grid;
  gap: var(--space-3);
}

.subpanel h3 {
  font-size: 13px;
  color: var(--c-text-2);
}

.dashboard-details {
  padding: 0;
  overflow: hidden;
}

.dashboard-details > summary {
  cursor: pointer;
  list-style: none;
  padding: var(--space-4);
  font-size: 12px;
  font-weight: 600;
  color: var(--c-text-2);
  border-bottom: 1px solid transparent;
}

.dashboard-details > summary::-webkit-details-marker {
  display: none;
}

.dashboard-details[open] > summary {
  border-bottom-color: var(--c-border);
}

.dashboard-details-body {
  display: grid;
  gap: var(--space-3);
  padding: 0 var(--space-4) var(--space-4);
}

.dashboard-details-subpanel {
  background: rgba(8, 14, 28, 0.65);
}

.grid-form {
  display: grid;
  gap: var(--space-3);
}

.grid-form.grid-inline {
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  align-items: end;
}

.grid-form.grid-4 {
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  align-items: end;
}

label {
  font-size: 11px;
  color: var(--c-text-2);
  display: grid;
  gap: 6px;
}

.checkbox-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

input,
select,
button,
textarea {
  font-family: var(--font-sans);
  font-size: 12px;
}

input,
select {
  min-height: 38px;
  background: var(--c-surface-1);
  color: var(--c-text-1);
  border: 1px solid var(--c-border);
  border-radius: var(--radius-sm);
  padding: 8px 10px;
}

input:focus,
select:focus,
button:focus {
  outline: 2px solid var(--c-accent);
  outline-offset: 1px;
}

button {
  min-height: 38px;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(76, 135, 255, 0.4);
  background: linear-gradient(135deg, var(--c-accent), #2d61cc);
  color: #ffffff;
  font-weight: 600;
  cursor: pointer;
  padding: 8px 12px;
}

button:hover {
  filter: brightness(1.05);
}

button:disabled {
  cursor: wait;
  opacity: 0.55;
}

.action-grid {
  display: grid;
  gap: var(--space-2);
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
}

.action-row {
  display: flex;
  justify-content: flex-end;
}

.action-row-spaced {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}

.two-col-grid {
  display: grid;
  gap: var(--space-3);
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.kpi-grid {
  display: grid;
  gap: var(--space-3);
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.kpi-grid-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.kpi-grid-5 {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

.kpi-card {
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  background: var(--c-surface-2);
  display: grid;
  gap: 6px;
}

.kpi-label {
  color: var(--c-text-3);
  font-size: 10px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.kpi-value {
  font-size: 20px;
  font-weight: 700;
}

.kpi-value.tone-success {
  color: var(--c-success);
}

.kpi-value.tone-warning {
  color: var(--c-warning);
}

.kpi-value.tone-accent {
  color: var(--c-accent);
}

.kpi-value.tone-danger {
  color: var(--c-danger);
}

.stack-list {
  display: grid;
  gap: var(--space-2);
}

.list-row {
  border: 1px solid var(--c-border);
  border-radius: var(--radius-sm);
  background: var(--c-surface-1);
  padding: 10px;
  display: grid;
  gap: 5px;
}

.list-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.list-title {
  font-size: 12px;
  font-weight: 600;
}

.list-meta {
  color: var(--c-text-3);
  font-size: 11px;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
}

.data-table th,
.data-table td {
  padding: 8px 6px;
  border-bottom: 1px solid var(--c-border);
  text-align: left;
  font-size: 11px;
}

.data-table th {
  color: var(--c-text-3);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.data-table td {
  color: var(--c-text-1);
}

.asset-class-badge {
  display: inline-flex;
  align-items: center;
  min-height: 20px;
  padding: 2px 7px;
  border-radius: 6px;
  border: 1px solid var(--c-border);
  background: var(--c-surface-2);
  color: var(--c-text-2);
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.asset-class-stock,
.asset-class-bdr {
  color: var(--c-accent);
  border-color: rgba(76, 135, 255, 0.38);
}

.asset-class-fii {
  color: var(--c-success);
  border-color: rgba(44, 197, 126, 0.38);
}

.asset-class-etf {
  color: var(--c-warning);
  border-color: rgba(255, 190, 92, 0.42);
}

.asset-class-fx {
  color: var(--c-purple);
  border-color: rgba(167, 139, 250, 0.4);
}

#dashboard-thesis-open-operations td {
  vertical-align: top;
  white-space: normal;
  line-height: 1.35;
}

.history-evolution-svg {
  width: 100%;
  height: 170px;
  border: 1px solid var(--c-border);
  border-radius: var(--radius-sm);
  background: rgba(6, 14, 30, 0.7);
}

.history-evolution-axis {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--c-text-3);
  font-size: 11px;
}

.history-weeks-grid {
  display: grid;
  gap: var(--space-2);
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.week-chart-card {
  gap: 8px;
}

.week-evolution-svg {
  width: 100%;
  height: 130px;
  border: 1px solid var(--c-border);
  border-radius: var(--radius-sm);
  background: rgba(6, 14, 30, 0.7);
}

.week-evolution-zero {
  stroke: rgba(148, 163, 184, 0.32);
  stroke-width: 1;
  stroke-dasharray: 3 4;
}

.game-images-grid {
  display: grid;
  gap: var(--space-3);
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.game-image-card {
  border: 1px solid var(--c-border);
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--c-surface-1);
  display: grid;
}

.game-image-card img {
  width: 100%;
  height: 140px;
  object-fit: cover;
  display: block;
}

.game-image-caption {
  padding: 8px 10px;
  font-size: 11px;
  color: var(--c-text-2);
}

.terminal-output {
  margin: 0;
  border-radius: var(--radius-sm);
  border: 1px solid var(--c-border);
  background: #050a18;
  color: #95e6ff;
  padding: var(--space-3);
  font-family: var(--font-mono);
  font-size: 11px;
  min-height: 76px;
  max-height: 240px;
  overflow: auto;
  white-space: pre-wrap;
}

.result-card {
  border: 1px solid var(--c-border);
  border-radius: var(--radius-sm);
  background: var(--c-surface-1);
  padding: 10px;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 6px 0;
  border-bottom: 1px solid rgba(27, 40, 69, 0.5);
  font-size: 11px;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-label {
  color: var(--c-text-3);
}

.kv-value {
  color: var(--c-text-1);
  font-family: var(--font-mono);
  font-weight: 600;
  text-align: right;
}

.skeleton-row {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  gap: 8px;
}

.skeleton-block {
  height: 14px;
  border-radius: 4px;
  background: linear-gradient(90deg, var(--c-surface-2) 25%, var(--c-surface-3) 50%, var(--c-surface-2) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.skeleton-card {
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  height: 72px;
  background: linear-gradient(90deg, var(--c-surface-1) 25%, var(--c-surface-2) 50%, var(--c-surface-1) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.ticker-selector {
  display: grid;
  gap: 8px;
  grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
}

.ticker-pill {
  min-height: 34px;
  border-radius: 999px;
  border: 1px solid var(--c-border);
  background: var(--c-surface-2);
  color: var(--c-text-2);
  cursor: pointer;
}

.ticker-pill.is-active {
  color: var(--c-accent);
  border-color: var(--c-accent);
  background: rgba(76, 135, 255, 0.12);
}

.order-side-selector {
  display: flex;
  gap: 8px;
}

.side-btn {
  flex: 1;
  min-height: 36px;
  border-radius: 8px;
  border: 1px solid var(--c-border);
  background: var(--c-surface-2);
  color: var(--c-text-2);
}

.side-btn.is-active.side-buy {
  border-color: var(--c-green);
  color: var(--c-green);
  background: rgba(16, 200, 122, 0.12);
}

.side-btn.is-active.side-sell {
  border-color: var(--c-red);
  color: var(--c-red);
  background: rgba(255, 64, 96, 0.12);
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-top: 12px;
}

.metric-card {
  background: var(--c-surface-1);
  border: 1px solid var(--c-border);
  border-radius: 10px;
  padding: 10px 12px;
}

.metric-label {
  color: var(--c-text-3);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  margin-bottom: 4px;
}

.metric-value {
  font-family: var(--font-mono);
  font-size: 16px;
  font-weight: 700;
}

.empty-hint {
  color: var(--c-text-3);
  font-size: 12px;
  text-align: center;
  padding: 20px;
}

.status-card {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  border-radius: 9px;
}

.status-ok {
  background: rgba(16, 200, 122, 0.08);
  border: 1px solid rgba(16, 200, 122, 0.3);
}

.status-alert {
  background: rgba(255, 64, 96, 0.08);
  border: 1px solid rgba(255, 64, 96, 0.3);
}

.status-ticker {
  color: var(--c-text-1);
  font-weight: 700;
}

.status-tag {
  font-size: 10px;
  font-weight: 700;
  padding: 2px 9px;
  border-radius: 20px;
  background: rgba(16, 200, 122, 0.15);
  color: var(--c-green);
}

.status-reason {
  width: 100%;
  color: var(--c-text-3);
  font-size: 11px;
  margin: 0;
}

.pill-selector {
  display: flex;
  gap: 6px;
  margin-bottom: 12px;
}

.pill-option {
  flex: 1;
  padding: 8px 4px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  background: var(--c-surface-2);
  border: 1px solid var(--c-border);
  color: var(--c-text-2);
}

.pill-option.is-active {
  background: rgba(76, 135, 255, 0.12);
  border-color: var(--c-accent);
  color: var(--c-accent);
}

.btn-danger {
  background: rgba(255, 64, 96, 0.15);
  border: 1px solid var(--c-red);
  color: var(--c-red);
}

.toggle-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.toggle-label {
  color: var(--c-text-2);
  font-size: 12px;
  flex: 1;
}

.toggle-switch {
  width: 42px;
  height: 22px;
  border-radius: 11px;
  background: var(--c-green);
  cursor: pointer;
  position: relative;
  transition: background 0.2s;
}

.toggle-switch.is-off {
  background: var(--c-red);
}

.toggle-thumb {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #fff;
  transition: left 0.2s;
}

.toggle-switch[aria-checked="false"] .toggle-thumb {
  left: calc(100% - 19px);
}

.slider-row {
  margin-bottom: 14px;
}

.slider-row label {
  display: block;
  color: var(--c-text-2);
  font-size: 12px;
  margin-bottom: 6px;
}

.slider-with-value {
  display: flex;
  align-items: center;
  gap: 12px;
}

.slider-with-value input[type="range"] {
  flex: 1;
  accent-color: var(--c-accent);
}

.slider-value {
  color: var(--c-accent);
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 16px;
  min-width: 36px;
  text-align: right;
}

.alert-type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  margin-bottom: 14px;
}

.notification-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 8px;
}

.alert-type-btn {
  padding: 9px 12px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 500;
  cursor: pointer;
  background: var(--c-surface-2);
  border: 1px solid var(--c-border);
  color: var(--c-text-2);
  text-align: left;
  transition: all 0.15s;
}

.alert-type-btn.is-active {
  background: rgba(76, 135, 255, 0.12);
  border-color: var(--c-accent);
  color: var(--c-accent);
}

.btn-primary {
  background: linear-gradient(135deg, var(--c-accent), #2d61cc);
  border: 1px solid rgba(76, 135, 255, 0.4);
  color: #fff;
}

.btn-ghost {
  background: transparent;
  border: 1px solid var(--c-border);
  color: var(--c-text-2);
}

.btn-full {
  width: 100%;
}

.auth-gate {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(7, 13, 31, 0.95);
  backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-modal {
  background: var(--c-surface-1);
  border: 1px solid var(--c-border);
  border-radius: 20px;
  padding: 36px;
  width: 420px;
  max-width: 92vw;
  box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6);
}

.auth-logo {
  text-align: center;
  margin-bottom: 24px;
}

.auth-product-name {
  color: var(--c-text-1);
  font-weight: 700;
  font-size: 18px;
  margin: 6px 0 2px;
}

.auth-product-sub {
  color: var(--c-text-3);
  font-size: 12px;
}

.auth-tabs {
  display: flex;
  background: var(--c-surface-2);
  border-radius: 10px;
  padding: 3px;
  margin-bottom: 22px;
}

.auth-tab {
  flex: 1;
  padding: 8px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  background: transparent;
  color: var(--c-text-3);
  border: none;
  cursor: pointer;
  min-height: 34px;
}

.auth-tab.is-active {
  background: var(--c-surface-3);
  color: var(--c-text-1);
}

.auth-panel {
  display: none;
}

.auth-panel.is-active {
  display: block;
}

.auth-form .field-group {
  margin-bottom: 14px;
}

.auth-form label {
  display: block;
  color: var(--c-text-2);
  font-size: 12px;
  font-weight: 500;
  margin-bottom: 5px;
}

.auth-form input[type="text"],
.auth-form input[type="email"],
.auth-form input[type="password"] {
  width: 100%;
  box-sizing: border-box;
  background: var(--c-surface-2);
  border: 1px solid var(--c-border);
  border-radius: 9px;
  padding: 10px 14px;
  color: var(--c-text-1);
  font-size: 13px;
  outline: none;
}

.input-with-toggle {
  position: relative;
}

.input-with-toggle input {
  padding-right: 40px;
}

.pw-toggle {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--c-text-3);
  cursor: pointer;
  min-height: 0;
  padding: 0;
}

.forgot-link {
  display: block;
  text-align: right;
  color: var(--c-accent);
  font-size: 12px;
  margin: -6px 0 14px;
}

.info-banner {
  background: rgba(76, 135, 255, 0.1);
  border: 1px solid rgba(76, 135, 255, 0.3);
  border-radius: 9px;
  padding: 10px 14px;
  font-size: 12px;
  color: var(--c-text-2);
  margin-bottom: 16px;
  line-height: 1.5;
}

.auth-disclaimer {
  text-align: center;
  font-size: 11px;
  color: var(--c-text-3);
  margin-top: 16px;
  line-height: 1.5;
}

.mfa-header {
  text-align: center;
  margin-bottom: 20px;
}

.mfa-title {
  color: var(--c-text-1);
  font-weight: 600;
}

.mfa-sub {
  color: var(--c-text-3);
  font-size: 12px;
  margin-top: 4px;
}

.mfa-inputs {
  display: flex;
  gap: 8px;
  justify-content: center;
  margin-bottom: 20px;
}

.mfa-digit {
  width: 44px;
  height: 52px;
  text-align: center;
  font-size: 22px;
  font-weight: 700;
  background: var(--c-surface-2);
  border: 1px solid var(--c-border);
  border-radius: 9px;
  color: var(--c-text-1);
  outline: none;
  font-family: monospace;
}

.mfa-resend {
  text-align: center;
  font-size: 12px;
  color: var(--c-text-3);
  margin-top: 10px;
}

.wizard-steps {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 24px;
}

.wizard-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background: var(--c-border);
  transition: all 0.3s;
}

.wizard-dot.is-active {
  width: 28px;
  background: var(--c-accent);
}

.wizard-dot.is-done {
  background: var(--c-green);
}

.wizard-icon {
  font-size: 40px;
  text-align: center;
  margin-bottom: 12px;
}

.wizard-title {
  text-align: center;
  color: var(--c-text-1);
  font-weight: 700;
  font-size: 20px;
  margin-bottom: 12px;
}

.wizard-body {
  text-align: center;
  color: var(--c-text-2);
  font-size: 13px;
  line-height: 1.7;
  margin-bottom: 16px;
}

.wizard-panel {
  display: none;
}

.wizard-panel.is-active {
  display: block;
}

.suitability-question {
  margin-bottom: 16px;
}

.suit-label {
  display: block;
  color: var(--c-text-3);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 6px;
}

.suit-options {
  display: flex;
  gap: 8px;
}

.suit-option {
  flex: 1;
  padding: 9px 4px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  background: var(--c-surface-2);
  border: 1px solid var(--c-border);
  color: var(--c-text-2);
}

.suit-option.is-selected {
  background: rgba(76, 135, 255, 0.12);
  border-color: var(--c-accent);
  color: var(--c-accent);
}

.wizard-nav-row {
  display: flex;
  gap: 10px;
  margin-top: 16px;
}

.profile-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 16px;
}

.profile-chip {
  background: var(--c-surface-2);
  border: 1px solid var(--c-border);
  border-radius: 10px;
  padding: 10px 8px;
  text-align: center;
}

.chip-label {
  display: block;
  color: var(--c-text-3);
  font-size: 9px;
  text-transform: uppercase;
  font-weight: 700;
}

.chip-value {
  display: block;
  color: var(--c-text-1);
  font-weight: 600;
  font-size: 12px;
  margin-top: 4px;
}

.sidebar {
  width: 188px;
  transition: width 0.2s ease;
  overflow: hidden;
}

.sidebar.is-collapsed {
  width: 60px;
}

.sidebar.is-collapsed .menu-label,
.sidebar.is-collapsed .brand-copy,
.sidebar.is-collapsed .user-meta,
.sidebar.is-collapsed .sidebar-action-btn span.menu-label {
  display: none;
}

.sidebar.is-collapsed .menu-item {
  justify-content: center;
  padding: 9px;
}

.sidebar.is-collapsed .brand-block {
  justify-content: center;
  padding: 14px 8px;
}

.mono {
  font-family: var(--font-mono);
}

.skeleton {
  border-radius: var(--radius-sm);
  height: 80px;
  background: linear-gradient(90deg, var(--c-surface-2), var(--c-surface-3), var(--c-surface-2));
  background-size: 220% 100%;
  animation: shimmer 1.2s infinite linear;
}

@keyframes shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: -100% 0;
  }
}

.toast-stack {
  position: fixed;
  top: 64px;
  right: 16px;
  display: grid;
  gap: 8px;
  z-index: 60;
}

.toast {
  min-width: 260px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--c-border);
  background: var(--c-surface-2);
  color: var(--c-text-1);
  padding: 10px 12px;
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.34);
  font-size: 12px;
}

.toast-success {
  border-color: rgba(16, 200, 122, 0.5);
}

.toast-error {
  border-color: rgba(255, 64, 96, 0.55);
}

.toast-warning {
  border-color: rgba(255, 168, 48, 0.55);
}

.global-disclaimer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 9px 14px;
  text-align: center;
  font-size: 10px;
  color: var(--c-text-3);
  background: rgba(255, 168, 48, 0.09);
  border-top: 1px solid rgba(255, 168, 48, 0.35);
  z-index: 50;
}

@media (max-width: 1279px) {
  .kpi-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 1023px) {
  .sidebar {
    position: fixed;
    transform: translateX(-110%);
    transition: transform 0.22s ease;
    width: 184px;
  }

  .sidebar .brand-copy,
  .sidebar .menu-label,
  .sidebar .user-meta {
    display: block;
  }

  .sidebar .menu-item {
    justify-content: flex-start;
  }

  body.sidebar-open .sidebar {
    transform: translateX(0);
  }

  .ghost-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .kpi-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .two-col-grid {
    grid-template-columns: 1fr;
  }

  .history-weeks-grid {
    grid-template-columns: 1fr;
  }

  .kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .topbar {
    padding-left: var(--space-3);
    padding-right: var(--space-3);
  }

  .main-content {
    padding: var(--space-3);
  }
}

@media (max-width: 767px) {
  .kpi-grid,
  .grid-form.grid-inline,
  .grid-form.grid-4 {
    grid-template-columns: 1fr;
  }

  .dashboard-head-actions {
    width: 100%;
    justify-content: stretch;
  }

  .dashboard-head-actions button {
    flex: 1;
  }

  .toast {
    min-width: 220px;
  }

  .topbar-status {
    gap: var(--space-2);
  }

  .feed-pill {
    padding: 5px 8px;
  }
}
